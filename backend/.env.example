PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.e2ho7df.mongodb.net/test?appName=Cluster0
JWT_SECRET=your_jwt_secret_key
PYTHON_ENGINE_URL=http://localhost:8000

# data.gov.in key for the Agmarknet daily mandi price feed.
# Without this the service falls back to data.gov.in's shared sample key, which
# is aggressively rate-limited and answers 429 under any real use.
# Get your own (free, instant): https://data.gov.in/user
AGMARKNET_API_KEY=your_data_gov_in_api_key

# Road geometry for the maps (drawing only — the dispatch ranking is unaffected).
# Defaults to OSRM's public demo server, which needs no key and is explicitly
# not for production traffic; point this at your own OSRM instance before any
# real load. Unreachable or rate-limited, the service draws straight legs and
# labels them as such.
OSRM_URL=https://router.project-osrm.org

# Gemini API Configuration for RAG Agent & Embeddings
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=embedding-001
RAG_RELEVANCE_THRESHOLD=0.42
RAG_TOP_K=5

